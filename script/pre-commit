#!/usr/bin/env bash
# Pre-commit gate per ~/.claude/instructions/development-rhythm.md
# Fails fast on: lint, build, or test failure.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] swift format lint..."
if ! swift format lint --recursive Sources Tests 2>&1 | tee /tmp/move-to-screen-fmt.log; then
    echo "[pre-commit] formatting issues found. Run 'swift format format --in-place --recursive Sources Tests' to fix."
    exit 1
fi

echo "[pre-commit] swift build..."
swift build

echo "[pre-commit] swift test..."
swift test

echo "[pre-commit] OK"
